- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \    def __init__(self):\n        gr.sync_block.__init__(self,\n           \
      \ name='Promedios_de_tiempos',\n            in_sig=[np.float32],\n         \
      \   out_sig=[np.float32, np.float32])  # Solo 2 salidas: RMS y Desviaci\xF3\
      n\n        \n        self.acum_anterior = 0      # Para suma de x\n        self.acum_anterior1\
      \ = 0     # Para suma de x\xB2\n        self.acum_anterior2 = 0     # Para suma\
      \ de (x-media)\xB2\n        self.Ntotales = 0\n\n    def work(self, input_items,\
      \ output_items):\n        x = input_items[0]\n        y0 = output_items[0] \
      \ # RMS\n        y1 = output_items[1]  # Desviaci\xF3n est\xE1ndar\n\n     \
      \   N = len(x)\n        self.Ntotales += N\n\n        # C\xE1lculo del promedio\
      \ (necesario para desviaci\xF3n)\n        suma_total_parcial = np.sum(x) + self.acum_anterior\n\
      \        self.acum_anterior = suma_total_parcial\n        promedio = suma_total_parcial\
      \ / self.Ntotales\n\n        # Media Cuadr\xE1tica (para RMS)\n        x2 =\
      \ x * x\n        suma_cuadrados_parcial = np.sum(x2) + self.acum_anterior1\n\
      \        self.acum_anterior1 = suma_cuadrados_parcial\n        media_cuadratica\
      \ = suma_cuadrados_parcial / self.Ntotales\n\n        # RMS (salida 0)\n   \
      \     y0[:] = np.sqrt(media_cuadratica)\n\n        # Desviaci\xF3n Est\xE1ndar\
      \ (salida 1)\n        x3 = (x - promedio) ** 2\n        suma_var_parcial = np.sum(x3)\
      \ + self.acum_anterior2\n        self.acum_anterior2 = suma_var_parcial\n  \
      \      y1[:] = np.sqrt(suma_var_parcial / self.Ntotales)\n\n        return len(x)"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Promedios_de_tiempos', 'blk', [], [('0', 'float', 1)], [('0', 'float',
      1), ('1', 'float', 1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [664, 104.0]
    rotation: 0
    state: enabled
- name: epy_block_0_0
  id: epy_block
  parameters:
    _source_code: "from gnuradio import gr\nimport numpy as np\n\nclass blk(gr.sync_block):\n\
      \    def __init__(self):\n        gr.sync_block.__init__(self,\n           \
      \ name=\"Diferenciador\",\n            in_sig=[np.float32],\n            out_sig=[np.float32])\n\
      \        \n        # CAMBIO 1: Variable movida al lugar correcto (dentro de\
      \ __init__)\n        self.acum_anterior = 0.0\n        \n        # MEJORA: Variable\
      \ para detectar cambios bruscos\n        self.ultimo_valor = 0.0\n\n    def\
      \ work(self, input_items, output_items):\n        x = input_items[0]  # se\xF1\
      al de entrada\n        y = output_items[0]  # se\xF1al diferenciada\n      \
      \  \n        for i in range(len(x)):\n            # CAMBIO 2: C\xE1lculo correcto\
      \ del diferenciador\n            # Original: diff = np.cumsum(x) - self.acum_anterior\
      \ (incorrecto)\n            # Ahora: diferencia muestra a muestra\n        \
      \    y[i] = x[i] - self.acum_anterior\n            self.acum_anterior = x[i]\n\
      \        \n        # MEJORA: Detectar si hubo un cambio muy brusco\n       \
      \ if abs(x[0] - self.ultimo_valor) > 10.0:\n            print(f\" Cambio brusco\
      \ detectado: {abs(x[0] - self.ultimo_valor):.2f}\")\n        \n        self.ultimo_valor\
      \ = x[-1]  # Guardar \xFAltimo valor para pr\xF3xima vez\n        \n       \
      \ return len(y)"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Diferenciador', 'blk', [], [('0', 'float', 1)], [('0', 'float', 1)],
      '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [760, 280.0]
    rotation: 0
    state: enabled
